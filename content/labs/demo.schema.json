{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansible-interactive-labs.github.io/labs/demo.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "hodId",
    "id",
    "demoId",
    "title",
    "objective",
    "coverImage",
    "coverAlt",
    "outcomes",
    "duration",
    "durationMinutes",
    "validationBoundary",
    "nextActions",
    "steps",
    "verification",
    "completionRecord"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "hodId": {
      "type": "string",
      "pattern": "^(ANSIBLE|RHEL)-HOD-[0-9]{3,}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "demoId": {
      "type": "string",
      "pattern": "^(ANSIBLE|RHEL)-HOD-[0-9]{3,}-D[0-9]{2,}$"
    },
    "title": {
      "type": "string",
      "minLength": 5
    },
    "objective": {
      "type": "string",
      "minLength": 20
    },
    "coverImage": {
      "type": "string",
      "pattern": "^/demos/.+\\.(png|jpg|jpeg|webp|svg)$"
    },
    "coverAlt": {
      "type": "string",
      "minLength": 10
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "duration": {
      "type": "string",
      "minLength": 3
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "validationBoundary": {
      "type": "string",
      "minLength": 40
    },
    "nextActions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 10
      }
    },
    "relatedHod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "detail",
        "href",
        "linkLabel"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 5
        },
        "detail": {
          "type": "string",
          "minLength": 20
        },
        "href": {
          "type": "string",
          "pattern": "^/demos/[a-z0-9]+(?:-[a-z0-9]+)*/$"
        },
        "linkLabel": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "title",
          "image",
          "alt",
          "explanation",
          "commands",
          "expected",
          "troubleshooting"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 3,
            "pattern": "^\\S+(?:\\s+\\S+)+$",
            "description": "A concise action-and-object phrase of at least two words, such as Check Repositories."
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "image": {
            "type": "string",
            "pattern": "^/demos/.+\\.(png|jpg|jpeg|webp|svg)$"
          },
          "alt": {
            "type": "string",
            "minLength": 10
          },
          "explanation": {
            "type": "string",
            "minLength": 20
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "command",
                "explanation"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 2
                },
                "explanation": {
                  "type": "string",
                  "minLength": 20,
                  "maxLength": 240
                }
              }
            }
          },
          "expected": {
            "type": "string",
            "minLength": 10
          },
          "note": {
            "type": "string"
          },
          "troubleshooting": {
            "type": "string",
            "minLength": 10
          },
          "recovery": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "symptom",
                "detail"
              ],
              "properties": {
                "symptom": {
                  "type": "string",
                  "minLength": 5
                },
                "detail": {
                  "type": "string",
                  "minLength": 20
                },
                "command": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          },
          "media": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "source",
              "transcript"
            ],
            "properties": {
              "type": {
                "const": "terminal"
              },
              "source": {
                "type": "string",
                "pattern": "^/demos/.+\\.cast$"
              },
              "transcript": {
                "type": "string",
                "pattern": "^/demos/.+\\.txt$"
              }
            }
          }
        }
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "completionRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "introduction",
        "maintenancePath",
        "items"
      ],
      "properties": {
        "introduction": {
          "type": "string",
          "minLength": 20
        },
        "maintenancePath": {
          "type": "string",
          "minLength": 20
        },
        "items": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 3
              },
              "value": {
                "type": "string",
                "minLength": 2
              }
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explanation",
        "command"
      ],
      "properties": {
        "explanation": {
          "type": "string",
          "minLength": 10
        },
        "command": {
          "type": "string",
          "minLength": 3
        }
      }
    }
  },
  "title": "Hands-On Demo"
}
