{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ansible-interactive-labs.github.io/labs/lab.schema.json",
  "title": "Rajat’s Applied Technology Lab Hands-On Demo",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "Available" } }, "required": ["status"] },
      "then": {
        "required": ["seoTitle", "seoDescription", "socialImage", "socialImageWidth", "socialImageHeight"],
        "properties": { "demos": { "minItems": 1 } }
      }
    },
    {
      "if": { "required": ["socialImage"] },
      "then": { "required": ["socialImageWidth", "socialImageHeight"] }
    }
  ],
  "required": [
    "schemaVersion", "hodId", "slug", "title", "shortDescription", "description",
    "coverImage", "coverAlt", "duration", "durationMinutes", "difficulty",
    "topic", "platform", "status", "hodNumber", "publishedOrder", "tags", "outcomes",
    "prerequisites", "demos"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2 },
    "hodId": { "type": "string", "pattern": "^HOD-[0-9]{3,}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "shortDescription": { "type": "string", "minLength": 10 },
    "description": { "type": "string", "minLength": 20 },
    "seoTitle": { "type": "string", "minLength": 10 },
    "seoDescription": { "type": "string", "minLength": 20 },
    "audience": { "type": "string", "minLength": 20 },
    "coverImage": { "type": "string", "pattern": "^/demos/.+\\.(png|jpg|jpeg|webp|svg)$" },
    "coverAlt": { "type": "string", "minLength": 10 },
    "socialImage": { "type": "string", "pattern": "^/demos/.+\\.(png|jpg|jpeg|webp)$" },
    "socialImageWidth": { "type": "integer", "minimum": 600 },
    "socialImageHeight": { "type": "integer", "minimum": 315 },
    "duration": { "type": "string", "minLength": 3 },
    "durationMinutes": { "type": "integer", "minimum": 1 },
    "difficulty": { "enum": ["Beginner", "Intermediate", "Expert"] },
    "topic": { "type": "string", "minLength": 2 },
    "platform": { "type": "string", "minLength": 2 },
    "status": { "enum": ["Available", "Coming soon"] },
    "hodNumber": { "type": "integer", "minimum": 1 },
    "publishedOrder": { "type": "integer", "minimum": 0 },
    "tags": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 2 } },
    "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "introduction", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "introduction": { "type": "string", "minLength": 20 },
        "itemsLabel": { "type": "string", "minLength": 3 },
        "items": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "detail": { "type": "string", "minLength": 10 }
            }
          }
        },
        "note": { "type": "string", "minLength": 10 },
        "relatedTools": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail", "status", "reference"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "detail": { "type": "string", "minLength": 20 },
              "status": { "type": "string", "minLength": 3 },
              "href": { "type": "string", "pattern": "^/" },
              "linkLabel": { "type": "string", "minLength": 3 },
              "primary": { "type": "boolean" },
              "reference": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "href"],
                "properties": {
                  "label": { "type": "string", "minLength": 3 },
                  "href": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "orchestrationOptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "introduction", "items", "note"],
          "properties": {
            "title": { "type": "string", "minLength": 5 },
            "introduction": { "type": "string", "minLength": 20 },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["title", "category", "detail", "reference"],
                "properties": {
                  "title": { "type": "string", "minLength": 2 },
                  "category": { "type": "string", "minLength": 3 },
                  "detail": { "type": "string", "minLength": 20 },
                  "href": { "type": "string", "pattern": "^/" },
                  "linkLabel": { "type": "string", "minLength": 3 },
                  "reference": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["label", "href"],
                    "properties": {
                      "label": { "type": "string", "minLength": 3 },
                      "href": { "type": "string", "format": "uri" }
                    }
                  }
                }
              }
            },
            "note": { "type": "string", "minLength": 20 }
          }
        }
      }
    },
    "prerequisites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "value", "detail"],
        "properties": {
          "label": { "type": "string", "minLength": 2 },
          "value": { "type": "string", "minLength": 2 },
          "detail": { "type": "string", "minLength": 5 },
          "href": { "type": "string", "format": "uri" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "introduction", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "introduction": { "type": "string", "minLength": 20 },
        "items": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "detail": { "type": "string", "minLength": 10 }
            }
          }
        }
      }
    },
    "supportGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "introduction", "routes", "diagnostics"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "introduction": { "type": "string", "minLength": 20 },
        "routes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail"],
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "detail": { "type": "string", "minLength": 20 },
              "reference": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "href"],
                "properties": {
                  "label": { "type": "string", "minLength": 3 },
                  "href": { "type": "string", "format": "uri" }
                }
              }
            }
          }
        },
        "diagnostics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "introduction", "items"],
          "properties": {
            "title": { "type": "string", "minLength": 5 },
            "introduction": { "type": "string", "minLength": 20 },
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["command", "detail"],
                "properties": {
                  "command": { "type": "string", "minLength": 2 },
                  "detail": { "type": "string", "minLength": 20 }
                }
              }
            }
          }
        }
      }
    },
    "prerequisiteCallouts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "paragraphs"],
        "properties": {
          "title": { "type": "string", "minLength": 5 },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 20 }
          },
          "links": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["href", "label"],
              "properties": {
                "href": { "type": "string", "format": "uri" },
                "label": { "type": "string", "minLength": 3 }
              }
            }
          }
        }
      }
    },
    "prerequisiteDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "introduction", "items"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "introduction": { "type": "string", "minLength": 20 },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/guidanceCallout" }
        }
      }
    },
    "nextStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eyebrow", "title", "detail", "status", "items"],
      "properties": {
        "eyebrow": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 5 },
        "detail": { "type": "string", "minLength": 20 },
        "status": { "type": "string", "minLength": 3 },
        "items": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 10 }
        },
        "href": { "type": "string", "pattern": "^/demos/[a-z0-9]+(?:-[a-z0-9]+)*/$" },
        "linkLabel": { "type": "string", "minLength": 3 },
        "reference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["href", "label"],
          "properties": {
            "href": { "type": "string", "format": "uri" },
            "label": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "introduction", "columns", "rows", "sources"],
        "properties": {
          "title": { "type": "string", "minLength": 5 },
          "introduction": { "type": "string", "minLength": 20 },
          "afterDemoId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "eyebrow": { "type": "string", "minLength": 3 },
          "notesLabel": { "type": "string", "minLength": 3 },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title", "detail"],
              "properties": {
                "title": { "type": "string", "minLength": 3 },
                "detail": { "type": "string", "minLength": 20 },
                "reference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "href"],
                  "properties": {
                    "label": { "type": "string", "minLength": 3 },
                    "href": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "cellLayout": { "type": "string", "enum": ["text", "stacked"] },
          "summaryLabel": { "type": "string", "minLength": 3 },
          "rowHeader": { "type": "string", "minLength": 2 },
          "takeawayLabel": { "type": "string", "minLength": 3 },
          "columns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "minLength": 2 }
          },
          "rows": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["aspect", "values"],
              "properties": {
                "aspect": { "type": "string", "minLength": 2 },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": { "type": "string", "minLength": 5 }
                },
                "reference": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "href"],
                  "properties": {
                    "label": { "type": "string", "minLength": 3 },
                    "href": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "takeaway": { "type": "string", "minLength": 20 },
          "followups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["title"],
              "anyOf": [
                { "required": ["paragraphs"] },
                { "required": ["items"] }
              ],
              "properties": {
                "title": { "type": "string", "minLength": 5 },
                "paragraphs": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 20 }
                },
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["title", "detail"],
                    "properties": {
                      "title": { "type": "string", "minLength": 3 },
                      "detail": { "type": "string", "minLength": 20 }
                    }
                  }
                }
              }
            }
          },
          "decisionGuide": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "introduction", "options", "pathTitle", "path"],
            "properties": {
              "label": { "type": "string", "minLength": 3 },
              "title": { "type": "string", "minLength": 5 },
              "introduction": { "type": "string", "minLength": 20 },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "label", "detail", "bestFor"],
                  "properties": {
                    "title": { "type": "string", "minLength": 3 },
                    "label": { "type": "string", "minLength": 2 },
                    "detail": { "type": "string", "minLength": 20 },
                    "bestFor": { "type": "string", "minLength": 10 },
                    "note": { "type": "string", "minLength": 20 },
                    "href": { "type": "string", "pattern": "^#demo-[a-z0-9]+(?:-[a-z0-9]+)*$" },
                    "linkLabel": { "type": "string", "minLength": 3 },
                    "reference": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["label", "href"],
                      "properties": {
                        "label": { "type": "string", "minLength": 3 },
                        "href": { "type": "string", "format": "uri" }
                      }
                    }
                  }
                }
              },
              "pathTitle": { "type": "string", "minLength": 3 },
              "path": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["condition", "result"],
                  "properties": {
                    "condition": { "type": "string", "minLength": 5 },
                    "result": { "type": "string", "minLength": 3 }
                  }
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "href"],
              "properties": {
                "label": { "type": "string", "minLength": 3 },
                "href": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    },
    "demos": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "demoId", "title", "objective", "coverImage", "coverAlt", "duration", "durationMinutes", "steps", "verification", "completionRecord"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "demoId": { "type": "string", "pattern": "^HOD-[0-9]{3,}-D[0-9]{2,}$" },
          "title": { "type": "string", "minLength": 5 },
          "objective": { "type": "string", "minLength": 20 },
          "coverImage": { "type": "string", "pattern": "^/demos/.+\\.(png|jpg|jpeg|webp|svg)$" },
          "coverAlt": { "type": "string", "minLength": 10 },
          "outcomes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } },
          "duration": { "type": "string", "minLength": 3 },
          "durationMinutes": { "type": "integer", "minimum": 1 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "title", "image", "alt", "explanation", "commands", "expected", "troubleshooting"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 3,
                  "pattern": "^\\S+(?:\\s+\\S+)+$",
                  "description": "A concise action-and-object phrase of at least two words, such as Check Repositories."
                },
                "title": { "type": "string", "minLength": 5 },
                "image": { "type": "string", "pattern": "^/demos/.+\\.(png|jpg|jpeg|webp|svg)$" },
                "alt": { "type": "string", "minLength": 10 },
                "explanation": { "type": "string", "minLength": 20 },
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["command", "explanation"],
                    "properties": {
                      "command": { "type": "string", "minLength": 2 },
                      "explanation": { "type": "string", "minLength": 20, "maxLength": 240 }
                    }
                  }
                },
                "expected": { "type": "string", "minLength": 10 },
                "note": { "type": "string" },
                "troubleshooting": { "type": "string", "minLength": 10 },
                "recovery": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["symptom", "detail"],
                    "properties": {
                      "symptom": { "type": "string", "minLength": 5 },
                      "detail": { "type": "string", "minLength": 20 },
                      "command": { "type": "string", "minLength": 2 }
                    }
                  }
                },
                "media": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "source", "transcript"],
                  "properties": {
                    "type": { "const": "terminal" },
                    "source": { "type": "string", "pattern": "^/demos/.+\\.cast$" },
                    "transcript": { "type": "string", "pattern": "^/demos/.+\\.txt$" }
                  }
                }
              }
            }
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 5 }
          },
          "completionRecord": {
            "type": "object",
            "additionalProperties": false,
            "required": ["introduction", "items"],
            "properties": {
              "introduction": { "type": "string", "minLength": 20 },
              "items": {
                "type": "array",
                "minItems": 4,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "value"],
                  "properties": {
                    "label": { "type": "string", "minLength": 3 },
                    "value": { "type": "string", "minLength": 2 }
                  }
                }
              }
            }
          },
          "cleanup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["explanation", "command"],
            "properties": {
              "explanation": { "type": "string", "minLength": 10 },
              "command": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "guidanceCallout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "paragraphs"],
      "properties": {
        "title": { "type": "string", "minLength": 5 },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 20 }
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["href", "label"],
            "properties": {
              "href": { "type": "string", "format": "uri" },
              "label": { "type": "string", "minLength": 3 }
            }
          }
        }
      }
    }
  }
}
