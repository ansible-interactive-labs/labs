:root {
  --ink: #121113;
  --muted: #67626a;
  --paper: #f6f3ef;
  --red: #e00;
  --red-dark: #a60000;
  --line: #ded9d3;
  --font-geist-sans: Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  --font-geist-mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--font-geist-sans), Arial, sans-serif;
}
button, a { font: inherit; }
button, a, summary, select { touch-action: manipulation; }
a { color: inherit; text-decoration: none; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
.skip-link { position: fixed; left: 18px; top: 10px; z-index: 999; padding: 10px 14px; color: white; background: var(--ink); transform: translateY(-150%); }
.skip-link:focus { transform: translateY(0); }
:focus-visible { outline: 3px solid #2b7fff; outline-offset: 3px; }

.topbar {
  height: 76px; display: flex; align-items: center; justify-content: space-between;
  padding: 0 clamp(22px, 6vw, 92px); border-bottom: 1px solid var(--line);
  padding-left: max(clamp(22px, 6vw, 92px), env(safe-area-inset-left));
  padding-right: max(clamp(22px, 6vw, 92px), env(safe-area-inset-right));
  background: rgba(246,243,239,.92); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 20;
}
.brand { display: flex; align-items: center; gap: 12px; font-weight: 720; letter-spacing: -.02em; }
.brand-mark { width: 40px; height: 40px; flex: 0 0 auto; border-radius: 50%; display: grid; place-items: center; color: white; background: var(--ink); font: 750 11px/1 var(--font-geist-mono); }
.brand-copy { display: grid; gap: 2px; }
.brand-copy strong { font-size: 15px; }
.brand-copy small { color: var(--muted); font-size: 9px; font-weight: 650; letter-spacing: .035em; }
.nav-items { display: flex; align-items: center; gap: 28px; }
.nav-link { font-size: 14px; font-weight: 650; border-bottom: 2px solid var(--red); padding-bottom: 4px; }
.nav-link.subtle { border-color: transparent; color: var(--muted); }
.mobile-nav { display: none; position: relative; }
.mobile-nav summary { min-width: 78px; padding: 10px 12px; border: 1px solid var(--line); cursor: pointer; list-style: none; text-align: center; font-size: 12px; font-weight: 750; }
.mobile-nav summary::-webkit-details-marker { display: none; }
.mobile-nav[open] summary { color: white; background: var(--ink); }
.mobile-nav > div { width: min(270px, calc(100vw - 32px)); position: absolute; top: calc(100% + 12px); right: 0; padding: 8px; display: grid; background: white; border: 1px solid var(--line); box-shadow: 0 18px 45px rgba(20,15,12,.18); }
.mobile-nav a { padding: 13px 14px; border-bottom: 1px solid var(--line); font-size: 13px; font-weight: 700; }
.mobile-nav a:last-child { border-bottom: 0; }
.mobile-nav a[aria-current="page"] { color: white; background: var(--red); }

.hero {
  min-height: 690px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(420px, .9fr);
  align-items: center; gap: clamp(50px, 8vw, 130px); padding: 86px clamp(22px, 6vw, 92px) 100px;
  overflow: hidden; position: relative;
}
.hero::before { content: ""; position: absolute; width: 520px; height: 520px; border: 1px solid #ddd5ce; border-radius: 50%; right: -270px; top: -170px; box-shadow: 0 0 0 70px rgba(255,255,255,.18), 0 0 0 140px rgba(255,255,255,.12); }
.eyebrow { text-transform: uppercase; letter-spacing: .15em; font-size: 12px; font-weight: 750; display: flex; align-items: center; gap: 10px; }
.eyebrow span { display: inline-block; width: 28px; height: 3px; background: var(--red); }
h1 { font-size: clamp(58px, 7.2vw, 106px); line-height: .91; letter-spacing: -.075em; margin: 24px 0 30px; font-weight: 760; }
h1 em { color: var(--red); font-style: normal; }
.hero-intro { max-width: 680px; font-size: clamp(18px, 1.6vw, 23px); line-height: 1.55; color: var(--muted); }
.hero-actions { display: flex; align-items: center; gap: 24px; margin-top: 38px; flex-wrap: wrap; }
.button { border: 0; border-radius: 2px; padding: 15px 20px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; gap: 22px; cursor: pointer; }
.button-primary { color: #fff; background: var(--red); box-shadow: 7px 7px 0 var(--red-dark); }
.button-dark { color: #fff; background: var(--ink); margin-top: 24px; }
.hero-note { font-size: 13px; color: var(--muted); }
.creator-link { display: inline-flex; align-items: center; gap: 10px; padding-bottom: 4px; border-bottom: 1px solid #a7a0a8; color: var(--ink); font-size: 13px; font-weight: 750; }

.hero-console { position: relative; background: #171619; color: #f7f4f1; border-radius: 10px; min-height: 330px; box-shadow: 28px 32px 0 #dcd5ce, 0 30px 60px rgba(20,15,12,.2); transform: rotate(1.4deg); z-index: 2; }
.console-bar { height: 52px; border-bottom: 1px solid #39363b; display: flex; align-items: center; padding: 0 18px; gap: 8px; color: #aaa3ac; font: 12px var(--font-geist-mono); }
.console-bar i { width: 11px; height: 11px; background: #59555b; border-radius: 50%; }
.console-bar i:first-child { background: var(--red); }
.console-bar span { margin-left: auto; }
.console-body { padding: 40px 34px; font: clamp(15px, 1.25vw, 20px)/1.7 var(--font-geist-mono); }
.console-body p { margin: 0; }
.console-body b { color: #ff514c; }
.console-body .success { color: #3bd67f; }
.console-body .indent { padding-left: 36px; color: #d8d3da; }
.console-cursor { display: inline-block; width: 10px; height: 20px; background: #eee; margin-top: 10px; animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0; } }

.catalog { background: #fff; padding: 100px clamp(22px, 6vw, 92px) 120px; }
.section-heading { display: grid; grid-template-columns: 1fr minmax(300px, 520px); gap: 50px; align-items: end; max-width: 1400px; margin: 0 auto 50px; }
h2 { font-size: clamp(38px, 4vw, 62px); letter-spacing: -.055em; margin: 14px 0 0; line-height: 1; }
.section-heading > p { color: var(--muted); line-height: 1.7; margin: 0; }
.prerequisite-callout { max-width: 1400px; margin: 0 auto 28px; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 20px; padding: 22px 24px; border: 1px solid #ddc8c2; background: #fff8f5; }
.callout-icon { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; color: white; background: var(--red); font-weight: 900; }
.prerequisite-callout strong { display: block; margin-bottom: 6px; }
.prerequisite-callout p { color: var(--muted); line-height: 1.55; font-size: 14px; margin: 0; }
.prerequisite-callout p a { color: var(--red-dark); text-decoration: underline; text-underline-offset: 3px; }
.prerequisite-callout code { color: var(--ink); font: 13px var(--font-geist-mono); }
.prerequisite-callout > a { white-space: nowrap; padding: 12px 14px; color: var(--red-dark); border: 1px solid #e5b5ac; font-size: 13px; font-weight: 750; }
.catalog-tools { max-width: 1400px; margin: 0 auto 28px; padding: 18px; display: grid; grid-template-columns: minmax(260px, 1fr) repeat(3, minmax(145px, .25fr)) auto; gap: 14px; align-items: end; border: 1px solid var(--line); background: #fff; }
.catalog-tools label { display: grid; gap: 7px; }
.catalog-tools label > span { color: var(--muted); text-transform: uppercase; letter-spacing: .09em; font-size: 10px; font-weight: 800; }
.catalog-tools input, .catalog-tools select { width: 100%; min-height: 46px; padding: 10px 12px; color: var(--ink); border: 1px solid #cbc5bf; border-radius: 0; background: var(--paper); }
.result-count { padding: 14px 8px; white-space: nowrap; color: var(--muted); font-size: 12px; }
.demo-grid { max-width: 1400px; margin: 0 auto; display: grid; gap: 28px; }
.demo-grid.compact-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.demo-card { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: 1.25fr .75fr; border: 1px solid var(--line); background: var(--paper); }
.compact-grid .demo-card { width: 100%; grid-template-columns: 1fr; align-content: start; }
.compact-grid .demo-visual { min-height: 0; aspect-ratio: 16 / 9; }
.compact-grid .demo-content { min-height: 100%; padding: 28px; justify-content: flex-start; }
.compact-grid h3 { margin: 22px 0 16px; font-size: 30px; }
.compact-grid .outcomes { margin-bottom: 24px; }
.compact-grid .button-dark { margin-top: auto; }
.demo-visual { min-height: 390px; position: relative; overflow: hidden; background: #111; border: 0; padding: 0; cursor: pointer; }
.demo-visual img { width: 100%; height: 100%; object-fit: cover; object-position: top left; position: absolute; inset: 0; }
.demo-visual::after { content: ""; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 45%, rgba(0,0,0,.38)); transition: background .25s ease; }
.demo-visual:hover::after { background: linear-gradient(120deg, transparent 30%, rgba(224,0,0,.22)); }
.play-button { width: 72px; height: 72px; border-radius: 50%; background: var(--red); color: white; display: grid; place-items: center; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); z-index: 2; padding-left: 5px; box-shadow: 0 14px 35px rgba(0,0,0,.28); transition: transform .2s ease; }
.demo-visual:hover .play-button { transform: translate(-50%, -50%) scale(1.08); }
.duration { position: absolute; right: 18px; bottom: 18px; background: #fff; border-radius: 99px; padding: 8px 12px; font-size: 12px; font-weight: 750; }
.hod-badge { position: absolute; z-index: 2; left: 18px; top: 18px; padding: 9px 11px; color: white; background: rgba(18,17,19,.9); font: 750 11px/1 var(--font-geist-mono); letter-spacing: .05em; }
.demo-content { padding: clamp(32px, 4vw, 64px); display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
.tags { display: flex; gap: 8px; flex-wrap: wrap; }
.tags span { font-size: 11px; text-transform: uppercase; letter-spacing: .08em; padding: 7px 9px; border: 1px solid #cbc5bf; }
h3 { font-size: clamp(34px, 3vw, 50px); line-height: 1; letter-spacing: -.045em; margin: 26px 0 20px; }
.demo-content p { color: var(--muted); line-height: 1.7; margin: 0; }
.outcomes { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; font-size: 14px; }
.outcomes li::before { content: "✓"; color: var(--red); font-weight: 900; margin-right: 10px; }
.empty-results { max-width: 1400px; margin: 0 auto; padding: 70px 24px; text-align: center; border: 1px dashed #cfc8c1; }
.empty-results p { color: var(--muted); }
.empty-results button { padding: 11px 15px; border: 1px solid var(--ink); background: transparent; cursor: pointer; }
.load-more-row { max-width: 1400px; margin: 30px auto 0; display: flex; justify-content: center; align-items: center; gap: 16px; }
.load-more-row button { min-height: 46px; padding: 11px 18px; border: 1px solid var(--ink); color: var(--ink); background: #fff; font-weight: 750; cursor: pointer; }
.load-more-row button:hover { color: #fff; background: var(--ink); }
.load-more-row span { color: var(--muted); font-size: 12px; }

.troubleshooting-section { max-width: 1400px; margin: 100px auto 0; padding-top: 80px; border-top: 1px solid var(--line); display: grid; grid-template-columns: minmax(280px, .72fr) minmax(0, 1.28fr); gap: clamp(50px, 8vw, 120px); }
.troubleshooting-intro { align-self: start; position: sticky; top: 110px; }
.troubleshooting-intro h2 { margin-bottom: 24px; }
.troubleshooting-intro > p:last-child { color: var(--muted); line-height: 1.7; max-width: 520px; }
.troubleshooting-list { border-top: 1px solid var(--line); }
.troubleshooting-list details { border-bottom: 1px solid var(--line); }
.troubleshooting-list summary { list-style: none; cursor: pointer; min-height: 78px; display: grid; grid-template-columns: 42px 1fr; align-items: center; gap: 14px; font-weight: 720; }
.troubleshooting-list summary::-webkit-details-marker { display: none; }
.troubleshooting-list summary::after { content: "+"; grid-column: 3; color: var(--red); font-size: 24px; font-weight: 400; }
.troubleshooting-list details[open] summary::after { content: "−"; }
.troubleshooting-list summary span { color: #9d969f; font: 12px var(--font-geist-mono); }
.troubleshooting-list details > div { padding: 0 0 28px 56px; }
.troubleshooting-list details p { color: var(--muted); line-height: 1.65; margin: 0 0 18px; }
.troubleshooting-list pre { margin: 0; padding: 16px; overflow-x: auto; color: #f7f4f1; background: #171619; font: 12px/1.7 var(--font-geist-mono); white-space: pre-wrap; overflow-wrap: anywhere; }

.lab-standard { padding: 110px clamp(22px, 6vw, 92px) 120px; color: white; background: #28252a; }
.standard-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #4a464c; border-left: 1px solid #4a464c; }
.standard-grid article { min-height: 250px; padding: 30px; border-right: 1px solid #4a464c; border-bottom: 1px solid #4a464c; }
.standard-grid article > span { color: #918b94; font: 12px var(--font-geist-mono); }
.standard-grid h3 { margin: 58px 0 14px; font-size: 27px; }
.standard-grid p { margin: 0; color: #b9b3bc; font-size: 14px; line-height: 1.65; }

.path-section { background: var(--ink); color: white; padding: 110px clamp(22px, 6vw, 92px) 120px; }
.path-heading { margin-bottom: 62px; }
.path-heading > p { color: #aaa4ac; }
.eyebrow.light span { background: #ff3934; }
.path-grid { max-width: 1400px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #3d393f; border-left: 1px solid #3d393f; }
.path-card { min-height: 280px; padding: 32px; border-right: 1px solid #3d393f; border-bottom: 1px solid #3d393f; position: relative; display: flex; flex-direction: column; }
.path-card > span { font: 13px var(--font-geist-mono); color: #7e7881; }
.path-card h3 { font-size: 27px; margin: 54px 0 16px; letter-spacing: -.035em; }
.path-card p { color: #aaa4ac; font-size: 14px; line-height: 1.6; margin: 0; }
.path-card small { text-transform: uppercase; letter-spacing: .1em; margin-top: auto; color: #6e6971; font-weight: 700; }
.path-card.active { background: var(--red); border-color: var(--red); }
.path-card.active > span, .path-card.active p, .path-card.active small { color: white; }

.creator-section { max-width: 1400px; margin: 0 auto; padding: 105px clamp(22px, 6vw, 92px); display: grid; grid-template-columns: minmax(190px, .35fr) minmax(320px, 1fr) minmax(300px, .72fr); align-items: center; gap: clamp(38px, 6vw, 90px); }
.creator-monogram { width: min(230px, 100%); aspect-ratio: 1; display: grid; place-items: center; color: white; background: var(--ink); box-shadow: 16px 16px 0 #dcd5ce; font: 800 clamp(48px, 6vw, 78px)/1 var(--font-geist-mono); letter-spacing: -.08em; }
.creator-monogram span { color: var(--red); }
.creator-copy h2 { max-width: 720px; }
.creator-copy > p:last-of-type { max-width: 700px; color: var(--muted); font-size: 16px; line-height: 1.75; }
.creator-copy .button { margin-top: 14px; }
.creator-actions { display: flex; align-items: center; gap: 22px; flex-wrap: wrap; margin-top: 14px; }
.creator-actions .button { margin-top: 0; }
.text-link { display: inline-flex; align-items: center; gap: 8px; color: var(--ink); border-bottom: 1px solid #aaa3ac; padding-bottom: 4px; font-size: 13px; font-weight: 750; }
.creator-principles { padding: 26px; border-top: 4px solid var(--red); background: white; box-shadow: 10px 10px 0 #e1dbd5; }
.creator-principles > span { color: var(--red-dark); text-transform: uppercase; letter-spacing: .12em; font-size: 10px; font-weight: 800; }
.creator-principles ul { list-style: none; margin: 18px 0 0; padding: 0; }
.creator-principles li { padding: 16px 0; border-top: 1px solid var(--line); }
.creator-principles strong, .creator-principles small { display: block; }
.creator-principles small { margin-top: 6px; color: var(--muted); line-height: 1.55; }

.content-families { max-width: 1400px; margin: 0 auto; padding: 105px clamp(22px, 6vw, 92px); border-top: 1px solid var(--line); }
.content-family-grid { margin-top: 58px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border: 1px solid var(--line); background: var(--line); }
.content-family-grid > a { min-height: 380px; padding: 34px; display: flex; flex-direction: column; background: var(--paper); transition: background .2s ease, color .2s ease; }
.content-family-grid > a:hover { color: white; background: var(--ink); }
.content-family-grid > a:first-child:hover { background: var(--red-dark); }
.content-family-grid small { align-self: flex-end; margin-top: -13px; color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.family-code { color: var(--red); font: 800 12px var(--font-geist-mono); letter-spacing: .08em; }
.content-family-grid h3 { margin: 80px 0 18px; font-size: 31px; }
.content-family-grid p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
.content-family-grid strong { margin-top: auto; padding-top: 28px; font-size: 12px; }
.content-family-grid strong i { float: right; font-style: normal; }
.section-link-row { margin-top: 34px; display: flex; justify-content: flex-end; }

.portfolio-evidence { padding: 105px clamp(22px, 6vw, 92px); display: grid; grid-template-columns: minmax(340px, .78fr) minmax(480px, 1fr); align-items: center; gap: clamp(60px, 9vw, 145px); color: white; background: var(--ink); }
.portfolio-heading { max-width: 680px; }
.portfolio-heading h2 { color: white; }
.portfolio-heading > p:last-of-type { color: #aaa4ac; font-size: 16px; line-height: 1.7; }
.portfolio-links { margin-top: 32px; display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
.portfolio-links .light-link { color: white; border-color: #6f6972; }
.portfolio-project { max-width: 760px; padding: clamp(30px, 4vw, 52px); color: var(--ink); background: var(--paper); box-shadow: 16px 16px 0 #3a363d; }
.portfolio-project-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
.portfolio-project-top > span { color: var(--red); font: 800 12px var(--font-geist-mono); letter-spacing: .08em; }
.portfolio-project-top small { color: #168449; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .09em; }
.portfolio-project-type { margin: 54px 0 10px !important; color: var(--red-dark) !important; font-size: 10px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
.portfolio-project h3 { margin: 0 0 18px; font-size: clamp(34px, 4vw, 52px); }
.portfolio-project > p { color: var(--muted); line-height: 1.65; }
.portfolio-project dl { margin: 30px 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.portfolio-project dl div { padding: 14px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.portfolio-project dt { margin-bottom: 6px; color: var(--muted); font-size: 9px; font-weight: 750; text-transform: uppercase; letter-spacing: .09em; }
.portfolio-project dd { margin: 0; font-size: 12px; font-weight: 750; }
.portfolio-project > strong { font-size: 11px; text-transform: uppercase; letter-spacing: .09em; }
.portfolio-project ul { margin: 16px 0 0; padding-left: 19px; color: var(--muted); font-size: 13px; line-height: 1.8; }

/* Scalable content hubs */
.hub-page { background: var(--paper); }
.hub-hero { max-width: 1400px; min-height: 610px; margin: 0 auto; padding: 95px clamp(22px, 6vw, 92px); display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(360px, .65fr); align-items: center; gap: clamp(50px, 8vw, 130px); }
.hub-hero h1 { max-width: 900px; margin: 20px 0 0; }
.hub-hero h1 em { color: var(--red); font-style: normal; }
.hub-intro > p { margin: 0; color: var(--muted); font-size: clamp(18px, 1.8vw, 23px); line-height: 1.65; }
.hub-intro dl { margin: 38px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.hub-intro dl div { padding: 17px 16px; border-left: 1px solid var(--line); }
.hub-intro dl div:first-child { padding-left: 0; border-left: 0; }
.hub-intro dt { margin-bottom: 7px; color: var(--muted); font-size: 9px; font-weight: 750; text-transform: uppercase; letter-spacing: .1em; }
.hub-intro dd { margin: 0; font-size: 14px; font-weight: 800; }
.hub-hero-dark { max-width: none; padding-left: max(clamp(22px, 6vw, 92px), calc((100vw - 1400px) / 2 + 92px)); padding-right: max(clamp(22px, 6vw, 92px), calc((100vw - 1400px) / 2 + 92px)); color: white; background: var(--ink); }
.hub-hero-dark h1 { color: white; }
.hub-hero-dark .hub-intro > p { color: #c2bcc5; }
.availability-pill { display: inline-block; margin-top: 34px; padding: 10px 12px; color: var(--red-dark); background: #fff0ed; font: 800 10px var(--font-geist-mono); text-transform: uppercase; letter-spacing: .09em; }
.hub-library, .solution-model, .case-types, .technology-directory { max-width: 1400px; margin: 0 auto; padding: 105px clamp(22px, 6vw, 92px); }
.format-standard { padding: 100px clamp(22px, 6vw, 92px); color: white; background: var(--ink); }
.format-standard > div { max-width: 1400px; margin-left: auto; margin-right: auto; }
.format-standard h2 { color: white; }
.format-standard-grid { margin-top: 55px; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid #3d393f; border-left: 1px solid #3d393f; }
.format-standard-grid article { min-height: 245px; padding: 30px; border-right: 1px solid #3d393f; border-bottom: 1px solid #3d393f; }
.format-standard-grid article > span { color: var(--red); font: 750 11px var(--font-geist-mono); }
.format-standard-grid strong { display: block; margin: 58px 0 13px; font-size: 22px; }
.format-standard-grid p { margin: 0; color: #aaa4ac; font-size: 13px; line-height: 1.6; }
.solution-layer-grid { margin-top: 58px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
.solution-layer-grid article { min-height: 260px; padding: 34px; border: 1px solid var(--line); background: white; }
.solution-layer-grid span { color: var(--red); font: 750 11px var(--font-geist-mono); }
.solution-layer-grid h3 { margin: 56px 0 15px; font-size: 28px; }
.solution-layer-grid p { margin: 0; color: var(--muted); line-height: 1.65; }
.hub-next { padding: 80px clamp(22px, 6vw, 92px); display: flex; align-items: end; justify-content: space-between; gap: 50px; color: white; background: var(--red-dark); }
.hub-next h2 { color: white; }
.hub-next p:last-child { max-width: 720px; color: #e9c6c1; }
.hub-next .button { flex: 0 0 auto; margin-bottom: 10px; background: white; color: var(--red-dark); box-shadow: 7px 7px 0 #751a10; }
.consulting-hero { background: #eee8e2; }
.case-type-grid { margin-top: 58px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; border: 1px solid var(--line); background: var(--line); }
.case-type-grid article { min-height: 340px; padding: 30px; background: var(--paper); }
.case-type-grid span { color: var(--red-dark); font: 800 10px var(--font-geist-mono); text-transform: uppercase; letter-spacing: .1em; }
.case-type-grid h3 { margin: 78px 0 18px; font-size: 26px; }
.case-type-grid p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
.technology-hero { background: #e8e4df; }
.technology-grid { margin-top: 58px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.technology-grid article { min-height: 330px; padding: 30px; display: flex; flex-direction: column; border: 1px solid var(--line); background: white; }
.technology-grid article.available { color: white; background: var(--ink); border-color: var(--ink); }
.technology-grid article > div { display: flex; justify-content: space-between; align-items: center; }
.technology-grid article > div > span { color: var(--red); font: 750 11px var(--font-geist-mono); }
.technology-grid article small { color: var(--muted); font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
.technology-category { margin: 52px 0 10px !important; color: var(--red-dark) !important; font-size: 10px !important; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
.technology-grid h3 { margin: 0 0 16px; font-size: 29px; }
.technology-grid article > p:not(.technology-category) { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
.technology-grid article > a, .planned-label { margin-top: auto; padding-top: 28px; font-size: 12px; font-weight: 750; }
.technology-grid article > a { color: white; }
.planned-label { color: var(--muted); }

body > main > footer { padding: 38px clamp(22px, 6vw, 92px); background: #09090a; color: white; border-top: 1px solid #2e2b30; }
body > main > footer .brand-mark { color: var(--ink); background: white; }
body > main > footer .brand-copy small { color: #8f8992; }
.footer-primary { display: flex; align-items: center; justify-content: space-between; gap: 30px; }
.footer-primary p { color: #c2bcc5; font-size: 13px; margin: 0; }
.footer-promise { text-align: center; }
.footer-promise small { display: block; margin-top: 6px; color: #77717a; font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
.footer-primary > a { color: #f2eef3; font-size: 12px; font-weight: 700; text-decoration: underline; text-underline-offset: 4px; }
.footer-author-links { display: flex; align-items: center; gap: 14px; font-size: 12px; font-weight: 700; }
.footer-author-links a { color: #f2eef3; text-decoration: underline; text-underline-offset: 4px; }
.trademark-disclaimer { max-width: 960px; margin: 28px 0 0; padding-top: 20px; border-top: 1px solid #2e2b30; color: #77717a; font-size: 10px; line-height: 1.6; }

/* Author profile */
.author-page { background: var(--paper); }
.author-hero { max-width: 1400px; min-height: calc(100vh - 76px); margin: 0 auto; padding: clamp(60px, 8vw, 120px) clamp(22px, 6vw, 92px); display: grid; grid-template-columns: minmax(280px, .65fr) minmax(500px, 1fr); align-items: center; gap: clamp(55px, 9vw, 135px); }
.author-identity { align-self: stretch; display: flex; flex-direction: column; justify-content: center; }
.author-monogram { width: min(430px, 100%); aspect-ratio: 1; display: grid; place-items: center; color: white; background: var(--ink); box-shadow: 24px 24px 0 #dcd5ce; font: 800 clamp(72px, 10vw, 140px)/1 var(--font-geist-mono); letter-spacing: -.09em; }
.author-monogram span { color: var(--red); }
.author-status { width: min(430px, 100%); margin-top: 46px; display: flex; align-items: center; gap: 10px; color: var(--muted); font: 700 10px/1.4 var(--font-geist-mono); text-transform: uppercase; letter-spacing: .07em; }
.author-status i { width: 8px; height: 8px; flex: 0 0 auto; border-radius: 50%; background: #25a45a; box-shadow: 0 0 0 4px rgba(37,164,90,.12); }
.author-introduction h1 { margin: 18px 0 30px; font-size: clamp(76px, 9vw, 132px); line-height: .82; letter-spacing: -.075em; }
.author-introduction h1 em { color: var(--red); font-style: normal; }
.author-lede { max-width: 760px; color: var(--muted); font-size: clamp(18px, 1.8vw, 24px); line-height: 1.58; }
.author-facts { margin-top: 34px; display: grid; grid-template-columns: .7fr 1fr; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
.author-facts span { padding: 18px 22px 18px 0; font-size: 13px; font-weight: 750; }
.author-facts span + span { padding-left: 22px; border-left: 1px solid var(--line); }
.author-facts small { display: block; margin-bottom: 7px; color: var(--muted); font-size: 9px; text-transform: uppercase; letter-spacing: .1em; }
.author-actions { display: flex; align-items: center; gap: 26px; flex-wrap: wrap; margin-top: 32px; }
.author-actions .text-link { font-size: 14px; }
.author-statement { padding: 105px clamp(22px, 6vw, 92px); display: grid; grid-template-columns: minmax(300px, .85fr) minmax(360px, 1fr); gap: clamp(60px, 9vw, 150px); color: white; background: var(--ink); }
.author-statement h2 { color: white; }
.author-story { max-width: 760px; }
.author-story > p { margin: 0 0 24px; color: #c1bbc3; font-size: 17px; line-height: 1.75; }
.author-story .source-note { margin-top: 38px; padding-top: 20px; border-top: 1px solid #39353b; color: #817b84; font-size: 11px; }
.author-expertise { max-width: 1400px; margin: 0 auto; padding: 110px clamp(22px, 6vw, 92px); }
.expertise-grid { margin-top: 58px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); }
.expertise-grid article { min-height: 300px; padding: 30px; background: var(--paper); }
.expertise-grid article > span { color: var(--red); font: 750 11px var(--font-geist-mono); }
.expertise-grid h3 { margin: 75px 0 18px; font-size: 27px; }
.expertise-grid p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.65; }
.author-approach { padding: 110px clamp(22px, 6vw, 92px); display: grid; grid-template-columns: .8fr 1fr; gap: clamp(60px, 9vw, 150px); color: white; background: var(--red-dark); }
.approach-heading { align-self: start; position: sticky; top: 110px; }
.approach-heading h2 { color: white; }
.approach-heading > p:last-child { max-width: 580px; color: #e9c6c1; line-height: 1.7; }
.author-approach ol { margin: 0; padding: 0; list-style: none; }
.author-approach li { padding: 28px 0; display: grid; grid-template-columns: 70px 1fr; gap: 20px; border-top: 1px solid rgba(255,255,255,.25); }
.author-approach li > span { font: 750 12px var(--font-geist-mono); color: #f2aaa1; }
.author-approach strong { display: block; margin-bottom: 8px; font-size: 20px; }
.author-approach li p { margin: 0; color: #e9c6c1; line-height: 1.6; }
.author-credential { max-width: 1216px; margin: 90px auto; padding: 42px 48px; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 50px; border: 1px solid #d7d0c9; background: white; box-shadow: 12px 12px 0 #e1dbd5; }
.author-credential div > span { color: var(--red-dark); font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
.author-credential strong { max-width: 760px; display: block; margin: 12px 0; font-size: clamp(22px, 2.3vw, 34px); line-height: 1.2; }
.author-credential p { max-width: 760px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.6; }
.author-credential > a { max-width: 250px; padding: 16px 18px; color: white; background: var(--ink); font-size: 12px; font-weight: 750; line-height: 1.45; }
.author-cta { max-width: 1400px; margin: 0 auto; padding: 70px clamp(22px, 6vw, 92px) 110px; display: flex; align-items: end; justify-content: space-between; gap: 50px; }
.author-cta h2 { margin-bottom: 0; }
.author-cta .button { flex: 0 0 auto; margin-bottom: 10px; }

.demo-overlay { position: fixed; inset: 0; z-index: 100; background: rgba(8,7,9,.78); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); padding: clamp(0px, 2vw, 30px); display: grid; place-items: center; }
.demo-player { width: min(1540px, 100%); max-height: 100%; overflow: auto; background: #f7f5f2; color: var(--ink); box-shadow: 0 30px 100px rgba(0,0,0,.5); }
.demo-player:fullscreen { width: 100vw; height: 100vh; height: 100svh; max-height: none; overflow: hidden; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; }
.demo-player:fullscreen .player-header, .demo-player:fullscreen .player-footer { position: static; }
.demo-player:fullscreen .player-stage { min-height: 0; overflow: hidden; }
.demo-player:fullscreen .stage-media { min-width: 0; min-height: 0; }
.demo-player:fullscreen .stage-guide { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; -webkit-overflow-scrolling: touch; }
.demo-player:fullscreen .terminal-replay { min-height: 0; }
.player-header { min-height: 74px; background: var(--ink); color: white; display: flex; align-items: center; justify-content: space-between; padding: 14px 24px; gap: 20px; position: sticky; top: 0; z-index: 5; }
.player-header > div:first-child { display: flex; align-items: baseline; gap: 16px; }
.player-kicker { text-transform: uppercase; font-size: 10px; letter-spacing: .15em; color: #aaa4ac; }
.player-header strong { font-size: 18px; }
.player-tools { display: flex; gap: 8px; }
.player-tools button, .player-tools a { color: white; background: #2a282c; border: 1px solid #454147; min-height: 38px; padding: 8px 11px; cursor: pointer; display: inline-flex; align-items: center; }
.player-tools a:last-child { font-size: 24px; line-height: 1; }
.player-progress { display: grid; grid-template-columns: repeat(7, 1fr); background: white; border-bottom: 1px solid var(--line); padding: 18px 24px; gap: 8px; }
.player-progress button, .progress-step { border: 0; background: transparent; color: #8b858d; display: grid; grid-template-columns: 28px 1fr; align-items: center; gap: 8px; text-align: left; min-width: 0; }
.player-progress button { cursor: pointer; }
.player-progress button span, .progress-step span { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; background: #e8e4df; font: 11px var(--font-geist-mono); }
.player-progress button small, .progress-step small { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.player-progress button.current { color: var(--ink); font-weight: 750; }
.player-progress button.current span { color: white; background: var(--red); box-shadow: 0 0 0 4px rgba(224,0,0,.12); }
.player-progress button.complete span { color: white; background: #22985b; }
.player-stage { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(360px, .7fr); min-height: 620px; }
.stage-media { background: #0b0a0c; position: relative; display: grid; place-items: center; overflow: hidden; }
.stage-media img { width: 100%; height: 100%; object-fit: contain; animation: stage-in .28s ease-out; }
.terminal-replay { width: 100%; height: 100%; min-width: 0; min-height: 0; align-self: stretch; display: grid; place-items: stretch; position: relative; overflow: hidden; }
.terminal-replay-mount { width: 100%; height: 100%; min-width: 0; min-height: 0; display: grid; place-items: center; overflow: hidden; }
.terminal-replay .ap-wrapper { width: 100%; height: 100%; max-width: 100%; max-height: 100%; box-shadow: 0 18px 55px rgba(0,0,0,.42); }
.terminal-replay-fallback { width: 100%; height: 100%; display: grid; place-items: center; }
.terminal-replay-fallback p { position: absolute; top: 14px; margin: 0; padding: 8px 11px; color: white; background: rgba(0,0,0,.8); font-size: 12px; }
.terminal-replay-links { position: absolute; z-index: 2; right: 18px; top: 18px; display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8px; }
.terminal-replay-links a { padding: 8px 10px; color: white; background: rgba(0,0,0,.72); font-size: 11px; font-weight: 700; }
@keyframes stage-in { from { opacity: .2; transform: scale(.985); } }
.stage-number { position: absolute; left: 18px; bottom: 18px; color: rgba(255,255,255,.58); font: 13px var(--font-geist-mono); background: rgba(0,0,0,.55); padding: 7px 9px; }
.image-link { position: absolute; right: 18px; bottom: 18px; padding: 8px 10px; color: white; background: rgba(0,0,0,.72); font-size: 11px; font-weight: 700; }
.stage-guide { padding: clamp(30px, 3.5vw, 56px); overflow-y: auto; -webkit-overflow-scrolling: touch; }
.step-label { color: var(--red); text-transform: uppercase; letter-spacing: .12em; font-size: 11px; font-weight: 800; margin: 0 0 18px; }
.stage-guide h2 { font-size: clamp(34px, 3vw, 52px); margin: 0 0 22px; }
.explanation { color: var(--muted); line-height: 1.65; margin: 0; }
.command-block { background: #171619; color: #f5f2f6; margin-top: 28px; box-shadow: 5px 5px 0 #d6d0c9; }
.command-block > div { display: flex; justify-content: space-between; align-items: center; padding: 10px 13px; border-bottom: 1px solid #3b383e; color: #aaa4ac; font-size: 10px; text-transform: uppercase; letter-spacing: .09em; }
.command-block button { border: 0; background: transparent; color: #ff5d58; cursor: pointer; font-weight: 800; }
.command-block pre { margin: 0; padding: 18px; white-space: pre-wrap; overflow-wrap: anywhere; font: 13px/1.7 var(--font-geist-mono); }
.command-block code { display: grid; gap: 14px; }
.command-line { display: block; }
.command-line + .command-line { padding-top: 14px; border-top: 1px solid #3b383e; }
.expected { border-left: 3px solid #24a864; margin-top: 28px; padding: 3px 0 3px 16px; }
.expected strong { text-transform: uppercase; letter-spacing: .1em; font-size: 10px; color: #168449; }
.expected p { margin: 7px 0 0; color: var(--muted); line-height: 1.55; font-size: 14px; }
.step-note { padding: 13px 14px; background: #ebe7e2; color: #5f5962; font-size: 12px; line-height: 1.5; margin: 24px 0 0; }
.step-troubleshooting { margin-top: 18px; border: 1px solid #d8d2cc; background: white; }
.step-troubleshooting summary { cursor: pointer; padding: 13px 14px; font-size: 12px; font-weight: 800; color: var(--red-dark); }
.step-troubleshooting p { color: var(--muted); font-size: 12px; line-height: 1.55; margin: 0; padding: 0 14px 14px; }
.demo-help { margin-top: 12px; border: 1px solid #d8d2cc; background: #f6f3ef; }
.demo-help > summary { cursor: pointer; padding: 13px 14px; font-size: 12px; font-weight: 800; }
.demo-help > div { padding: 0 14px 14px; }
.demo-help article { padding: 16px 0; border-top: 1px solid #d8d2cc; }
.demo-help article p { margin: 7px 0 10px; color: var(--muted); font-size: 12px; line-height: 1.55; }
.demo-help pre, .demo-cleanup pre { margin: 0; padding: 12px; overflow-x: auto; color: #f7f4f1; background: #171619; font: 11px/1.6 var(--font-geist-mono); white-space: pre-wrap; overflow-wrap: anywhere; }
.step-feedback { display: inline-block; margin-top: 18px; color: var(--muted); font-size: 11px; text-decoration: underline; text-underline-offset: 3px; }
.player-footer { min-height: 72px; background: white; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 15px; padding: 12px 24px; position: sticky; bottom: 0; }
.route-player.is-running .player-footer { padding-bottom: max(12px, env(safe-area-inset-bottom)); padding-left: max(24px, env(safe-area-inset-left)); padding-right: max(24px, env(safe-area-inset-right)); }
.player-footer > span { color: #9b959d; font-size: 11px; }
.player-footer button { border: 0; padding: 12px 17px; cursor: pointer; font-weight: 750; }
.player-back { justify-self: start; background: transparent; }
.player-back:disabled { opacity: .35; cursor: default; }
.player-next { justify-self: end; color: white; background: var(--red); }
.complete-button { background: #168449; }
.stage-guide-utilities { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 28px; padding-top: 18px; border-top: 1px solid #d8d2cc; color: #716b73; font-size: 11px; }
.stage-guide-utilities button { padding: 0; border: 0; background: transparent; color: inherit; cursor: pointer; text-decoration: underline; }
.stage-guide-utilities a { text-decoration: underline; }
.player-ready { min-height: 0; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(360px, .7fr); overflow: hidden; }
.player-ready-visual { min-width: 0; min-height: 0; display: grid; place-items: center; padding: clamp(20px, 4vw, 58px); background: #0b0a0c; }
.player-ready-visual img { width: 100%; height: 100%; object-fit: contain; }
.player-ready aside { min-height: 0; overflow-y: auto; padding: clamp(30px, 3.5vw, 56px); }
.player-ready h2 { margin: 0 0 20px; font-size: clamp(34px, 3vw, 52px); }
.player-ready aside > p:not(.step-label) { color: var(--muted); line-height: 1.65; }
.player-ready .player-creator { margin: 18px 0 0; padding-top: 16px; border-top: 1px solid var(--line); font-size: 12px; }
.player-ready .player-creator a { color: var(--red-dark); font-weight: 750; text-decoration: underline; text-underline-offset: 3px; }
.player-ready ul { margin: 24px 0 0; padding-left: 20px; color: var(--muted); line-height: 1.65; }
.player-complete { min-height: 0; overflow-y: auto; display: grid; grid-template-columns: minmax(180px, .35fr) minmax(0, 1fr); align-items: start; gap: clamp(30px, 6vw, 90px); padding: clamp(34px, 6vw, 88px); background: #f7f4f0; }
.completion-mark { width: clamp(120px, 16vw, 210px); aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; color: white; background: #168449; font-size: clamp(64px, 9vw, 120px); box-shadow: 14px 14px 0 #d8d2cc; }
.player-complete h2 { margin: 0 0 16px; font-size: clamp(36px, 4vw, 58px); }
.player-complete aside > p:not(.step-label) { max-width: 780px; color: var(--muted); line-height: 1.65; }
.player-complete ul { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--line); }
.player-complete li { display: grid; grid-template-columns: 26px 1fr; gap: 8px; padding: 13px 16px 13px 0; border-bottom: 1px solid var(--line); font-size: 13px; line-height: 1.45; }
.player-complete li span { color: #168449; font-weight: 900; }
.demo-cleanup { margin-top: 24px; border: 1px solid #d8d2cc; background: white; }
.demo-cleanup summary { cursor: pointer; padding: 14px 16px; font-size: 12px; font-weight: 800; }
.demo-cleanup p { margin: 0; padding: 2px 16px 14px; color: var(--muted); font-size: 12px; line-height: 1.55; }
.demo-cleanup pre { margin: 0 16px 16px; }
.ready-footer { grid-template-columns: 1fr auto; }
.ready-footer > span { justify-self: start; }
.start-lab-button { min-width: 150px; }

@media (min-width: 901px) {
  .demo-player:fullscreen .player-stage { grid-template-columns: minmax(0, 1.5fr) minmax(360px, .7fr); }
}

.lab-page { background: var(--paper); }
.lab-topbar { background: rgba(246,243,239,.96); }
.lab-hero { max-width: 1400px; margin: 0 auto; padding: 78px clamp(22px, 5vw, 72px) 72px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(330px, .42fr); align-items: end; gap: clamp(50px, 8vw, 120px); }
.lab-hero h1 { max-width: 950px; font-size: clamp(54px, 6.5vw, 96px); }
.lab-description { max-width: 760px; color: var(--muted); font-size: 19px; line-height: 1.65; }
.lab-hero .lab-byline { margin: 22px 0 0; color: var(--muted); font-size: 13px; }
.lab-byline a { color: var(--ink); font-weight: 750; text-decoration: underline; text-underline-offset: 4px; }
.lab-facts { display: flex; flex-wrap: wrap; gap: 1px; margin-top: 34px; }
.lab-facts > span { min-width: 130px; padding: 14px 16px; background: #ebe7e2; font-size: 13px; font-weight: 750; }
.lab-facts small { display: block; margin-bottom: 5px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; font-size: 9px; }
.verification-card { padding: 26px; color: white; background: var(--ink); box-shadow: 10px 10px 0 #d9d2cb; }
.verification-card > span { display: block; margin-bottom: 18px; color: #ff5d58; text-transform: uppercase; letter-spacing: .12em; font-size: 10px; font-weight: 800; }
.verification-card dl { margin: 0; }
.verification-card dl div { padding: 12px 0; border-top: 1px solid #3a373c; }
.verification-card dt { color: #938d96; font-size: 10px; }
.verification-card dd { margin: 4px 0 0; font: 12px/1.5 var(--font-geist-mono); }
.verification-card p { margin: 18px 0 0; color: #aaa4ac; font-size: 11px; line-height: 1.55; }
.lab-overview { max-width: 1400px; margin: 0 auto 78px; padding: 58px clamp(22px, 5vw, 72px); color: white; background: var(--ink); }
.overview-heading { display: grid; grid-template-columns: minmax(280px, .8fr) 1fr; gap: 18px 70px; align-items: end; }
.overview-heading .eyebrow { grid-column: 1 / -1; color: #d8d1d8; }
.overview-heading h2 { margin: 0; color: white; font-size: clamp(38px, 4vw, 58px); }
.overview-heading > p:last-child { margin: 0; color: #c6c0c7; line-height: 1.7; }
.overview-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin-top: 38px; border-top: 1px solid #4a454c; border-left: 1px solid #4a454c; }
.overview-grid article { min-width: 0; padding: 24px 20px; border-right: 1px solid #4a454c; border-bottom: 1px solid #4a454c; }
.overview-grid article > span { color: #ff8d80; font: 700 11px/1 var(--font-geist-mono); }
.overview-grid h3 { margin: 32px 0 10px; color: white; font-size: 18px; letter-spacing: -.02em; }
.overview-grid p { margin: 0; color: #bdb7bf; font-size: 12px; line-height: 1.65; }
.overview-note { margin: 20px 0 0; padding: 18px 20px; color: #d9d3da; background: #302c32; font-size: 13px; line-height: 1.65; }
.overview-note strong { color: white; }
.lab-prerequisites { max-width: 1400px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px) 70px; display: grid; grid-template-columns: minmax(240px, .36fr) 1fr; gap: 50px; }
.lab-prerequisites h2 { font-size: 42px; }
.prerequisite-grid { display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
.prerequisite-grid article { padding: 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: white; }
.prerequisite-grid article > span { display: block; color: var(--red); text-transform: uppercase; letter-spacing: .1em; font-size: 9px; font-weight: 800; }
.prerequisite-grid strong { display: block; margin: 10px 0 8px; }
.prerequisite-grid p { color: var(--muted); font-size: 12px; line-height: 1.55; margin: 0; }
.prerequisite-grid a { display: inline-block; margin-top: 10px; color: var(--red-dark); font-size: 11px; text-decoration: underline; }
.comparison-section { max-width: 1400px; margin: 0 auto 78px; padding: 58px clamp(22px, 5vw, 72px); border-top: 4px solid var(--red); background: #fff; }
.comparison-heading { display: grid; grid-template-columns: minmax(280px, .9fr) 1fr; gap: 18px 70px; align-items: end; }
.comparison-heading .eyebrow { grid-column: 1 / -1; }
.comparison-heading h2 { margin: 0; font-size: clamp(36px, 4vw, 56px); }
.comparison-heading > p:last-child { margin: 0; color: var(--muted); line-height: 1.7; }
.comparison-deep-dive { margin-top: 28px; border: 1px solid var(--line); }
.comparison-deep-dive > summary { cursor: pointer; padding: 18px 20px; color: var(--red-dark); font-weight: 800; }
.comparison-deep-dive[open] > summary { border-bottom: 1px solid var(--line); }
.comparison-table-wrap { margin-top: 38px; overflow-x: auto; border: 1px solid var(--line); }
.comparison-deep-dive .comparison-table-wrap { margin: 0; border: 0; }
.comparison-table-wrap table { width: 100%; min-width: 760px; border-collapse: collapse; table-layout: fixed; }
.comparison-table-wide table { min-width: 1120px; }
.comparison-table-wrap th, .comparison-table-wrap td { padding: 18px 20px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; white-space: pre-line; font-size: 13px; line-height: 1.6; }
.comparison-table-wrap tr > *:last-child { border-right: 0; }
.comparison-table-wrap tbody tr:last-child > * { border-bottom: 0; }
.comparison-table-wrap thead th { color: #fff; background: var(--ink); font-size: 12px; }
.comparison-table-wrap thead th:first-child { width: 22%; color: #bcb6bf; }
.comparison-table-wrap tbody th { color: var(--ink); background: #f2eee9; }
.comparison-takeaway { margin-top: 20px; padding: 22px 24px; border-left: 4px solid var(--red); background: #fff4f1; }
.comparison-takeaway > strong { display: block; }
.comparison-takeaway p { margin: 8px 0 12px; line-height: 1.65; }
.comparison-takeaway > span { color: var(--muted); font-size: 11px; }
.comparison-takeaway a { color: var(--red-dark); text-decoration: underline; text-underline-offset: 3px; }
.demo-modules { max-width: 1600px; margin: 0 auto; padding: 20px 0 40px; }
.demo-modules-heading { max-width: 1400px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px) 46px; }
.demo-modules-heading h2 { margin: 8px 0 12px; font-size: clamp(44px, 5vw, 72px); }
.demo-modules-heading > p:last-child { max-width: 760px; margin: 0; color: var(--muted); line-height: 1.65; }
.demo-module + .demo-module { margin-top: 92px; padding-top: 70px; border-top: 1px solid var(--line); }
.demo-module-heading { max-width: 1400px; margin: 0 auto; padding: 0 clamp(22px, 5vw, 72px) 28px; display: grid; grid-template-columns: minmax(300px, .8fr) 1fr auto; align-items: end; gap: 26px 60px; }
.demo-module-heading span { color: var(--red); text-transform: uppercase; letter-spacing: .12em; font-size: 10px; font-weight: 800; }
.demo-module-heading h3 { margin: 8px 0 0; font-size: clamp(30px, 3vw, 46px); }
.demo-module-heading > p { margin: 0; color: var(--muted); line-height: 1.65; }
.demo-module-heading dl { display: flex; gap: 22px; margin: 0; }
.demo-module-heading dl div { min-width: 70px; }
.demo-module-heading dt { color: var(--muted); text-transform: uppercase; letter-spacing: .08em; font-size: 9px; }
.demo-module-heading dd { margin: 5px 0 0; font-weight: 800; }
.player-shell { padding: 0 clamp(12px, 3vw, 46px) 70px; }
.route-player { width: min(1540px, 100%); height: 100vh; height: 100svh; max-width: 1540px; max-height: none; margin: 0 auto; overflow: hidden; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; border: 1px solid #cfc9c3; box-shadow: 0 24px 70px rgba(20,15,12,.16); overscroll-behavior: contain; }
.route-player.is-running { position: fixed; inset: 0; z-index: 100; width: 100vw; max-width: none; margin: 0; border: 0; box-shadow: none; }
.route-player:fullscreen { overflow: hidden; }
.route-player .player-header, .route-player .player-footer { position: static; }
.route-player .player-stage { min-height: 0; overflow: hidden; }
.route-player .stage-media { min-width: 0; min-height: 0; }
.route-player .stage-guide { min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-gutter: stable; -webkit-overflow-scrolling: touch; }
.route-player .terminal-replay { min-height: 0; }
.feedback-band { max-width: 1400px; margin-left: auto; margin-right: auto; }
.feedback-band { margin-top: 55px; margin-bottom: 90px; padding: 28px 32px; display: flex; justify-content: space-between; align-items: center; gap: 24px; border: 1px solid #e0b0a8; background: #fff4f1; }
.feedback-band p { margin: 5px 0 0; color: var(--muted); font-size: 13px; }
.feedback-band a { padding: 12px 15px; color: white; background: var(--red); font-weight: 750; white-space: nowrap; }
.feedback-actions { display: flex; align-items: center; gap: 10px; }
.feedback-actions a:last-child { color: var(--ink); border: 1px solid #d6aca5; background: white; }

@media (max-width: 1120px) {
  .primary-nav .nav-items { display: none; }
  .primary-nav .mobile-nav { display: block; }
}
@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr; padding-top: 64px; }
  .hero-console { min-height: 280px; }
  .section-heading, .demo-card { grid-template-columns: 1fr; }
  .catalog-tools { grid-template-columns: 1fr 1fr; }
  .demo-grid.compact-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .search-field { grid-column: 1 / -1; }
  .demo-visual { min-height: 300px; }
  .path-grid { grid-template-columns: repeat(2, 1fr); }
  .standard-grid { grid-template-columns: repeat(2, 1fr); }
  .creator-section { grid-template-columns: minmax(150px, .35fr) 1fr; }
  .creator-principles { grid-column: 1 / -1; }
  .content-family-grid { grid-template-columns: 1fr; }
  .content-family-grid > a { min-height: 290px; }
  .content-family-grid h3 { margin-top: 50px; }
  .portfolio-evidence { grid-template-columns: 1fr; }
  .portfolio-project { max-width: none; }
  .hub-hero { min-height: auto; grid-template-columns: 1fr; }
  .format-standard-grid { grid-template-columns: repeat(2, 1fr); }
  .case-type-grid { grid-template-columns: repeat(2, 1fr); }
  .technology-grid { grid-template-columns: repeat(2, 1fr); }
  .hub-next { align-items: flex-start; flex-direction: column; }
  .author-hero { min-height: auto; grid-template-columns: .55fr 1fr; gap: 60px; }
  .author-statement, .author-approach { grid-template-columns: 1fr; }
  .expertise-grid { grid-template-columns: repeat(2, 1fr); }
  .approach-heading { position: static; }
  .author-credential { margin-left: 36px; margin-right: 36px; }
  .prerequisite-callout { grid-template-columns: auto 1fr; }
  .prerequisite-callout > a { grid-column: 2; justify-self: start; }
  .troubleshooting-section { grid-template-columns: 1fr; }
  .troubleshooting-intro { position: static; }
  .lab-hero { grid-template-columns: 1fr; }
  .overview-heading { grid-template-columns: 1fr; }
  .overview-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .comparison-heading { grid-template-columns: 1fr; }
  .lab-prerequisites, .demo-module-heading, .player-complete { grid-template-columns: 1fr; }
  .demo-module-heading { align-items: start; }
  .player-stage { grid-template-columns: 1fr; }
  .stage-media { min-height: 430px; }
  .route-player .player-stage { grid-template-rows: minmax(220px, 42%) minmax(0, 1fr); }
  .route-player .stage-media { min-height: 0; }
  .player-ready { grid-template-columns: 1fr; grid-template-rows: minmax(220px, 45%) minmax(0, 1fr); }
  .completion-mark { width: 130px; }
  .player-progress button, .progress-step { grid-template-columns: 1fr; justify-items: center; }
  .player-progress button small, .progress-step small { display: none; }
}
@media (max-width: 540px) {
  .topbar { height: 66px; }
  .nav-link { display: none; }
  .hero { min-height: auto; padding-bottom: 76px; }
  h1 { font-size: clamp(46px, 15vw, 62px); letter-spacing: -.065em; }
  h2 { font-size: 38px; }
  h3 { font-size: 34px; }
  .hero-console { transform: none; box-shadow: 12px 14px 0 #dcd5ce; min-height: 250px; }
  .console-body { padding: 28px 20px; }
  .catalog { padding-top: 76px; }
  .catalog-tools { grid-template-columns: 1fr; }
  .demo-grid.compact-grid { grid-template-columns: 1fr; }
  .search-field { grid-column: auto; }
  .result-count { padding: 4px 0; }
  .load-more-row { align-items: stretch; flex-direction: column; text-align: center; }
  .prerequisite-callout { grid-template-columns: 1fr; padding: 20px; }
  .prerequisite-callout > a { grid-column: 1; width: 100%; text-align: center; }
  .callout-icon { width: 36px; height: 36px; }
  .demo-visual { min-height: 220px; }
  .troubleshooting-section { margin-top: 72px; padding-top: 62px; gap: 34px; }
  .troubleshooting-list summary { min-height: 70px; grid-template-columns: 32px 1fr; gap: 10px; font-size: 14px; }
  .troubleshooting-list details > div { padding-left: 42px; }
  .nav-items { display: none; }
  .path-grid { grid-template-columns: 1fr; }
  .standard-grid { grid-template-columns: 1fr; }
  .creator-section { grid-template-columns: 1fr; padding-top: 72px; padding-bottom: 72px; }
  .creator-monogram { width: 150px; }
  .brand-copy small { max-width: 175px; }
  .footer-primary { align-items: flex-start; flex-direction: column; }
  .footer-promise { text-align: left; }
  .footer-author-links { align-items: flex-start; flex-direction: column; }
  .primary-nav .brand-copy small { max-width: 185px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .content-families { padding-top: 72px; padding-bottom: 72px; }
  .content-family-grid > a { min-height: 270px; padding: 26px; }
  .portfolio-evidence { padding-top: 72px; padding-bottom: 72px; gap: 48px; }
  .portfolio-project dl { grid-template-columns: 1fr; }
  .hub-hero { padding-top: 65px; padding-bottom: 70px; gap: 38px; }
  .hub-hero h1 { font-size: clamp(48px, 14vw, 65px); }
  .hub-intro dl { grid-template-columns: 1fr; }
  .hub-intro dl div, .hub-intro dl div:first-child { padding: 14px 0; border-left: 0; border-top: 1px solid var(--line); }
  .hub-intro dl div:first-child { border-top: 0; }
  .hub-library, .solution-model, .case-types, .technology-directory { padding-top: 72px; padding-bottom: 72px; }
  .format-standard { padding-top: 72px; padding-bottom: 72px; }
  .format-standard-grid, .solution-layer-grid, .case-type-grid, .technology-grid { grid-template-columns: 1fr; }
  .format-standard-grid article { min-height: 220px; }
  .solution-layer-grid article { min-height: 240px; }
  .case-type-grid article { min-height: 280px; }
  .technology-grid article { min-height: 290px; }
  .hub-next { padding-top: 65px; padding-bottom: 65px; }
  .author-hero { padding-top: 58px; grid-template-columns: 1fr; gap: 64px; }
  .author-monogram { width: 190px; box-shadow: 14px 14px 0 #dcd5ce; }
  .author-status { width: auto; margin-top: 30px; }
  .author-introduction h1 { font-size: clamp(66px, 21vw, 92px); }
  .author-facts { grid-template-columns: 1fr; }
  .author-facts span + span { padding-left: 0; border-top: 1px solid var(--line); border-left: 0; }
  .author-statement, .author-expertise, .author-approach { padding-top: 72px; padding-bottom: 72px; }
  .expertise-grid { grid-template-columns: 1fr; }
  .expertise-grid article { min-height: 250px; }
  .expertise-grid h3 { margin-top: 48px; }
  .author-approach li { grid-template-columns: 46px 1fr; }
  .author-credential { margin: 60px 22px; padding: 30px; grid-template-columns: 1fr; gap: 28px; }
  .author-credential > a { max-width: none; }
  .author-cta { padding-top: 45px; padding-bottom: 75px; align-items: flex-start; flex-direction: column; }
  .demo-overlay { padding: 0; }
  .demo-player { width: 100%; height: 100%; max-height: none; }
  .player-header { min-height: 64px; }
  .player-header > div:first-child { display: block; }
  .player-kicker, .player-tools button span { display: none; }
  .player-progress { padding: 14px 10px; gap: 2px; }
  .stage-media { min-height: 250px; }
  .terminal-replay-links { right: 10px; top: 10px; }
  .stage-guide { padding: 28px 22px 105px; }
  .image-link { right: 10px; bottom: 10px; }
  .stage-number { left: 10px; bottom: 10px; }
  .player-footer { grid-template-columns: 1fr 1fr; }
  .player-footer > span { display: none; }
  .player-footer button { min-height: 44px; }
  .lab-hero { padding-top: 54px; }
  .lab-hero h1 { font-size: 48px; }
  .lab-facts { display: grid; grid-template-columns: 1fr 1fr; }
  .lab-facts > span { min-width: 0; }
  .lab-prerequisites { padding-bottom: 54px; }
  .lab-overview { margin-bottom: 54px; padding-top: 42px; padding-bottom: 42px; }
  .overview-grid { grid-template-columns: 1fr; }
  .comparison-section { margin-bottom: 54px; padding-top: 42px; padding-bottom: 42px; }
  .demo-modules { padding-top: 0; }
  .demo-modules-heading { padding-bottom: 34px; }
  .demo-module-heading { padding-bottom: 22px; gap: 18px; }
  .demo-module-heading dl { width: 100%; }
  .prerequisite-grid { grid-template-columns: 1fr; }
  .player-shell { padding-left: 0; padding-right: 0; }
  .route-player { border-left: 0; border-right: 0; }
  .route-player { height: 100vh; height: 100svh; }
  .route-player .player-header { min-height: 70px; }
  .route-player .player-tools button span { display: none; }
  .ready-footer { grid-template-columns: 1fr; }
  .ready-footer .start-lab-button { grid-column: 1; width: 100%; }
  .player-complete { padding: 28px 22px; }
  .player-complete ul { grid-template-columns: 1fr; }
  .feedback-band { margin: 45px 22px 70px; align-items: flex-start; flex-direction: column; }
  .feedback-band a { width: 100%; text-align: center; }
  .feedback-actions { width: 100%; align-items: stretch; flex-direction: column; }
}
@media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } .console-cursor, .stage-media img { animation: none; } }

@media print {
  .topbar, .hero, .path-section, .lab-standard, .player-tools, .player-progress, .player-footer, .feedback-band { display: none !important; }
  .lab-hero, .lab-overview, .lab-prerequisites, .comparison-section, .demo-modules, .demo-module-heading { display: block; padding: 24px 0; }
  .player-stage { display: block; }
  .stage-media { min-height: 0; background: white; }
  .stage-media img { max-height: 420px; }
  .terminal-replay-mount, .terminal-replay-links { display: none; }
  .terminal-replay { padding: 0; }
  .terminal-replay::before { content: "Terminal replay available in the online lab. Use the linked transcript for a text equivalent."; color: black; }
}
