{
  "name": "rajats-applied-technology-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "validate:labs": "node scripts/validate-labs.mjs",
    "validate:browsers": "node scripts/check-browser-support.mjs",
    "validate:site": "pnpm validate:labs && pnpm validate:browsers",
    "build": "pnpm validate:site && next build",
    "postbuild": "node scripts/validate-staging-indexing.mjs",
    "start": "next start",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next"
  },
  "browserslist": [
    "chrome 125",
    "edge 125",
    "firefox 124",
    "safari 17.3",
    "last 1 ios_saf version",
    "last 1 and_chr version"
  ],
  "dependencies": {
    "asciinema-player": "^3.17.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
