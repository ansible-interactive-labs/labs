{
  "name": "rajats-applied-technology-lab",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "validate:labs": "node scripts/validate-labs.mjs",
    "validate:browsers": "node scripts/check-browser-support.mjs",
    "validate:site": "pnpm validate:labs && pnpm validate:browsers",
    "build": "pnpm validate:site && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next"
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4",
    "ios_saf 16.4"
  ],
  "dependencies": {
    "asciinema-player": "^3.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
